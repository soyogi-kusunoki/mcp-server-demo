{
  "name": "mcp-server-demo",
  "version": "1.0.0",
  "description": "TypeScript製MCPサーバーのデモ",
  "main": "build/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "dev:auth": "tsx watch src/auth-server/index.ts",
    "start": "node build/index.js",
    "start:auth": "node --disable-warning=ExperimentalWarning build/auth-server/index.js",
    "demo:client": "tsx src/demo-client/index.ts",
    "typecheck": "tsc --noEmit",
    "inspect": "npx @modelcontextprotocol/inspector"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/soyogi-kusunoki/mcp-server-demo.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/soyogi-kusunoki/mcp-server-demo/issues"
  },
  "homepage": "https://github.com/soyogi-kusunoki/mcp-server-demo#readme",
  "dependencies": {
    "@better-auth/cimd": "^1.7.25",
    "@better-auth/mcp": "^1.7.25",
    "@better-auth/oauth-provider": "^1.7.25",
    "@modelcontextprotocol/client": "^2.4.0",
    "@modelcontextprotocol/express": "^2.0.2",
    "@modelcontextprotocol/node": "^2.1.2",
    "@modelcontextprotocol/server": "^2.4.0",
    "better-auth": "^1.7.25",
    "express": "^5.3.0",
    "jose": "^6.2.17",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "type": "module",
  "files": [
    "build"
  ],
  "engines": {
    "node": ">=22.13"
  }
}
